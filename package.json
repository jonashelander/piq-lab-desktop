{
  "name": "piq-lab-desktop",
  "version": "0.1.0",
  "description": "PIQ Lab — configurable mock integration API, desktop edition",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "dist": "npm run build && electron-builder"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "typescript": "^5.7.0",
    "vite": "^5.0.0"
  },
  "dependencies": {
    "@ngrok/ngrok": "^1.7.0",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "uuid": "^11.0.0"
  },
  "build": {
    "appId": "com.paymentiq.piq-lab",
    "productName": "PIQ Lab",
    "icon": "resources/icon",
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "resources/icon.icns",
      "identity": null,
      "target": [
        { "target": "dmg", "arch": ["arm64", "x64"] }
      ]
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*"
    ]
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.21.5": true,
    "fsevents@2.3.3": true
  }
}
